{
  "manifest_version": 3,
  "name": "SafeClick Scanner",
  "version": "1.0",
  "description": "Scan links instantly from any page.",
  "permissions": [
    "contextMenus", 
    "scripting", 
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}